generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  NO_SHOW
  CANCELED
}

model Appointment {
  id              String            @id @default(uuid())
  name            String // Nome do pacient
  email           String
  phone           String
  appointmentDate DateTime // Data do agendamento
  time            String // horário escolhido
  status AppointmentStatus @default(SCHEDULED)
  source          AppointmentSource @default(DENTIST) // quem criou
  ipAddress       String?
  confirmationSentAt DateTime?
  reminderSentAt     DateTime?
  clinicalRecords ClinicalRecord[]

  serviceId String // id do serviço agendado
  service   Service @relation(fields: [serviceId], references: [id])

  userId String // id da clinica (user)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  patientId String?
  patient   Patient? @relation(fields: [patientId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, appointmentDate, time])
  @@index([ipAddress, createdAt])
}

enum AppointmentSource {
  PATIENT
  DENTIST
}

model Reminder {
  id          String @id @default(uuid())
  description String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id       String  @id @default(uuid())
  name     String
  price    Int
  duration Int
  status   Boolean @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointment Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Plan {
  BASIC
  PROFESSIONAL
  PREMIUM
}

model Subscription {
  id      String @id @default(uuid())
  status  String
  plan    Plan
  priceId String

  cancelAtPeriodEnd Boolean   @default(false)
  currentPeriodEnd  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  address            String?   @default("")
  phone              String?   @default("")
  status             Boolean   @default(true)
  timeZone           String?
  stripe_customer_id String?
  times              String[]  @default([])
  weekDays           Int[]     @default([1, 2, 3, 4, 5])
  onboardingCompletedAt DateTime?
  onboardingSkippedAt   DateTime?

  subscription Subscription?
  services     Service[]
  reminders    Reminder[]
  appointments Appointment[]

  accounts      Account[]
  sessions      Session[]
  patients Patient[]
  Authenticator Authenticator[]
  scheduleBlocks ScheduleBlock[]
  financialTransactions FinancialTransaction[]

  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  lastDashboardVisitAt   DateTime?
}

model Patient {
  id        String    @id @default(cuid())
  name      String
  email     String
  phone     String
  birthDate DateTime?
  notes     String?   @default("")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  appointments Appointment[]
  toothRecords     ToothRecord[]
  clinicalRecords  ClinicalRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, email]) // mesmo paciente não se duplica dentro da mesma clínica
  @@index([userId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Optional for WebAuthn support
model Authenticator {
  credentialID         String  @unique
  userId               String
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model ScheduleBlock {
  id        String   @id @default(cuid())

  startDate DateTime // meia-noite UTC do primeiro dia bloqueado
  endDate   DateTime // meia-noite UTC do último dia bloqueado (igual a startDate se for 1 dia só)

  startTime String?  // "12:00" — se null, bloqueia o(s) dia(s) inteiro(s)
  endTime   String?  // "13:00"

  recurring Boolean  @default(false) // true = repete todo dia da semana, ignora o range de datas (usa startDate só como "a partir de quando")

  reason    String?  // "Férias", "Feriado", "Almoço", "Consulta médica" etc.

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, startDate])
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
}

model FinancialTransaction {
  id          String             @id @default(cuid())
  description String
  amount      Int                // em centavos, mesmo padrão de Service.price
  type        TransactionType
  status      TransactionStatus  @default(PENDING)
  category    String?            // ex: "Material", "Aluguel", "Consulta avulsa"
  dueDate     DateTime
  paidAt      DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, dueDate])
}


enum ToothCondition {
  HEALTHY
  CAVITY
  RESTORED
  ROOT_CANAL
  CROWN
  EXTRACTED
  MISSING
  IMPLANT
}

model ToothRecord {
  id        String         @id @default(cuid())
  toothNumber Int          // notação FDI: 11-18, 21-28, 31-38, 41-48 (dentição adulta)
  condition   ToothCondition @default(HEALTHY)
  notes       String?

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@unique([patientId, toothNumber])
}

model ClinicalRecord {
  id          String   @id @default(cuid())
  title       String
  description String

  patientId String
  patient   Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  appointmentId String?
  appointment   Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  userId String // clínica/dentista que registrou

  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
}